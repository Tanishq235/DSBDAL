import pandas as pd

# Column names
columns = [
    'sepal_length',
    'sepal_width',
    'petal_length',
    'petal_width',
    'species'
]

# Load dataset
df = pd.read_csv("iris.data", names=columns)

# First rows
print(df.head())

# Dataset info
print(df.info())

# Unique species
print(df['species'].unique())

# Group by species
grouped = df.groupby('species')

# Mean
print(grouped.mean())

# Median
print(grouped.median())

# Min
print(grouped.min())

# Max
print(grouped.max())

# Standard deviation
print(grouped.std())

# Percentiles
print(grouped.quantile(0.25))
print(grouped.quantile(0.50))
print(grouped.quantile(0.75))

# Full statistics
print(grouped.describe())
